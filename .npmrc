# Supply-chain hardening
# These settings limit damage from compromised npm packages like the
# Mini Shai-Hulud / axios / node-ipc incidents in 2026.

# Don't auto-run preinstall/install/postinstall scripts from any package.
# All recent npm supply-chain attacks (axios@1.14.1, node-ipc@9.1.6,
# the SAP/TanStack/Mistral packages) deliver their payload via these hooks.
# bufferutil and utf-8-validate (optional discord.js deps) need scripts to
# compile native bindings — without them they fall back to JS implementations,
# which is fine.
ignore-scripts=true

# Avoid newly-published versions. Most malicious package versions are caught
# and unpublished within a few days. This is what CISA recommends post-axios.
# Requires npm >= 10.9. If your npm is older, this line is harmless (ignored).
min-release-age=7d

# Run audits on install
audit-level=moderate

# Don't fund-message-spam
fund=false
